{
  "manifest_version": 3,
  "name": "Wake on LAN",
  "version": "1.0.0",
  "description": "Wybudzanie komputerów przez Wake-on-LAN za pomocą serwera wake-on-lan.php.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wake on LAN",
    "default_icon": {
      "16": "icons/default/icon16.png",
      "32": "icons/default/icon32.png",
      "48": "icons/default/icon48.png",
      "128": "icons/default/icon128.png"
    }
  },
  "icons": {
    "16": "icons/default/icon16.png",
    "32": "icons/default/icon32.png",
    "48": "icons/default/icon48.png",
    "128": "icons/default/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
